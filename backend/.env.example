# Bahi Khata — backend configuration
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env
#
# Extracted from actual os.environ usage in the code. Variables marked REQUIRED
# have no default — the app raises KeyError on startup without them.

# ── REQUIRED ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=bahikhata_db

# Signs and verifies session JWTs. Generate a long random value per environment
# and never reuse it between them — changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Seeded on first startup. If the account already exists, the password is reset
# to this value on every boot — so treat it as a live credential, not just a seed.
ADMIN_EMAIL=admin@bahikhata.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins. "*" is the default and is fine locally, but auth uses
# a cookie — set explicit origins in production or the browser will reject it.
CORS_ORIGINS=http://localhost:3000

# ── Passkeys / WebAuthn ───────────────────────────────────────────────────────
# RP_ID is the bare domain (no scheme, no port). WebAuthn requires HTTPS in
# production; it will not work over plain http except on localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Bahi Khata
WEBAUTHN_ORIGIN=http://localhost:3000

# ── CRIF High Mark — credit bureau ────────────────────────────────────────────
# UAT or PROD. Selects which set of credentials below is used.
#
# IMPORTANT: CRIF whitelists source IP addresses. A new server will be refused
# until its IP is registered with CRIF against your member ID, regardless of
# whether these credentials are correct.
CRIF_ENV=UAT
CRIF_SUB_MBR_ID=RADHYA MICRO FINANCE PRIVATE LIMITED

# UAT (test) endpoint
CRIF_URL=
CRIF_USER_ID=
CRIF_PASSWORD=
CRIF_MBRID=

# PROD (live, billed per inquiry)
CRIF_PROD_URL=
CRIF_PROD_USER_ID=
CRIF_PROD_PASSWORD=
CRIF_PROD_MBRID=

# ── Emergent platform (REMOVED IN PHASE 2) ────────────────────────────────────
# Used by core/storage.py for object storage and by routes/ocr.py for Gemini
# vision calls. Phase 2 replaces both with S3-compatible storage and the Google
# Gemini SDK, after which this is no longer needed.
EMERGENT_LLM_KEY=
