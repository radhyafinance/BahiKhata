# Bahi Khata — frontend configuration
#
# Copy to .env and adjust:
#   cp .env.example .env
#
# Create React App only exposes variables prefixed REACT_APP_, and they are
# baked in at BUILD time, not read at runtime — a change here needs a rebuild,
# and anything put in this file ships to the browser. Never put a secret here.

# Base URL of the backend. The code appends "/api" itself, so this must NOT
# include a trailing /api or a trailing slash.
REACT_APP_BACKEND_URL=http://localhost:8000
